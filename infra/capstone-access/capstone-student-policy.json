{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BedrockPretrainedInferenceOnly",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream",
        "bedrock:Converse",
        "bedrock:ConverseStream",
        "bedrock:ListFoundationModels",
        "bedrock:GetFoundationModel",
        "bedrock:ListInferenceProfiles",
        "bedrock:GetInferenceProfile",
        "bedrock:Retrieve",
        "bedrock:RetrieveAndGenerate"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyBedrockTrainingAndCustomization",
      "Effect": "Deny",
      "Action": [
        "bedrock:CreateModelCustomizationJob",
        "bedrock:CreateProvisionedModelThroughput",
        "bedrock:CreateModelImportJob",
        "sagemaker:*",
        "comprehend:*Training*",
        "rekognition:*Training*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "NoComputeInstancesEver(serverless-only)",
      "Effect": "Deny",
      "Action": [
        "ec2:RunInstances",
        "ec2:StartInstances",
        "sagemaker:CreateEndpoint",
        "sagemaker:CreateNotebookInstance",
        "ecs:RunTask",
        "ecs:CreateCluster",
        "eks:CreateCluster",
        "emr:RunJobFlow",
        "rds:CreateDBInstance",
        "rds:CreateDBCluster",
        "elasticache:CreateCacheCluster",
        "redshift:CreateCluster"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ServerlessCompute",
      "Effect": "Allow",
      "Action": [
        "lambda:*",
        "apigateway:*",
        "states:*",
        "scheduler:*",
        "events:*"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": { "aws:RequestedRegion": "us-east-1" }
      }
    },
    {
      "Sid": "ServerlessStorageAndData",
      "Effect": "Allow",
      "Action": [
        "s3:*",
        "dynamodb:*",
        "sqs:*",
        "sns:*"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": { "aws:RequestedRegion": "us-east-1" }
      }
    },
    {
      "Sid": "EdgeAndStaticHosting",
      "Effect": "Allow",
      "Action": [
        "cloudfront:*",
        "acm:RequestCertificate",
        "acm:DescribeCertificate",
        "acm:ListCertificates"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ObservabilityReadAndOwnLogs",
      "Effect": "Allow",
      "Action": [
        "logs:*",
        "cloudwatch:PutMetricData",
        "cloudwatch:GetMetricData",
        "cloudwatch:ListMetrics",
        "xray:PutTraceSegments",
        "xray:PutTelemetryRecords"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IamForServerlessExecutionRolesScopedToCapstonePrefix",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:GetRole",
        "iam:PassRole",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:GetRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:TagRole",
        "iam:CreatePolicy",
        "iam:DeletePolicy",
        "iam:CreatePolicyVersion"
      ],
      "Resource": [
        "arn:aws:iam::654654327431:role/capstone-*",
        "arn:aws:iam::654654327431:policy/capstone-*"
      ]
    },
    {
      "Sid": "DenyIamPrivilegeEscalationOutsidePrefix",
      "Effect": "Deny",
      "Action": [
        "iam:CreateUser",
        "iam:CreateAccessKey",
        "iam:AttachUserPolicy",
        "iam:PutUserPolicy",
        "iam:CreateLoginProfile",
        "iam:UpdateAssumeRolePolicy",
        "organizations:*",
        "account:*",
        "billing:*",
        "aws-portal:*",
        "ce:*",
        "budgets:ModifyBudget"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CloudFormationForServerlessDeploys",
      "Effect": "Allow",
      "Action": [
        "cloudformation:*"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": { "aws:RequestedRegion": "us-east-1" }
      }
    },
    {
      "Sid": "ReadOnlyHelpers",
      "Effect": "Allow",
      "Action": [
        "sts:GetCallerIdentity",
        "pricing:GetProducts",
        "pricing:DescribeServices",
        "tag:GetResources"
      ],
      "Resource": "*"
    }
  ]
}
